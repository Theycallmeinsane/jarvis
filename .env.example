# Copy to .env and fill in only what you use. Local mode needs none of these.

# Claude (llm.provider: claude, or the "ask Claude" tool from a local brain)
ANTHROPIC_API_KEY=

# Any OpenAI-compatible server that needs a key (Groq, OpenRouter, OpenAI...)
OPENAI_COMPAT_API_KEY=

# Web search engines (optional; DuckDuckGo through ddgs works with no key). The first one set up is used.
# Brave Search API: https://brave.com/search/api/
BRAVE_API_KEY=
# Google Programmable Search: an API key + a search engine id (cx)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Tavily (search made for AI agents): https://tavily.com
TAVILY_API_KEY=

# Keep Hugging Face downloads quiet
HF_HUB_DISABLE_SYMLINKS_WARNING=1
