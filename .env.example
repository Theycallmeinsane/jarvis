# Copy to .env and fill in only what you use. Local mode needs none of these.

# Claude (llm.provider: claude, or the "ask Claude" tool from a local brain)
ANTHROPIC_API_KEY=

# Any OpenAI-compatible server that needs a key (Groq, OpenRouter, OpenAI...)
OPENAI_COMPAT_API_KEY=

# Keep Hugging Face downloads quiet
HF_HUB_DISABLE_SYMLINKS_WARNING=1
