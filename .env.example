# Copy to .env and fill in only what you use. Local mode needs none of these.

# Claude (llm.provider: claude, or the "ask Claude" tool from a local brain)
ANTHROPIC_API_KEY=

# Any OpenAI-compatible server that needs a key (Groq, OpenRouter, OpenAI...)
OPENAI_COMPAT_API_KEY=

# Spotify (full control: playlists, liked songs, queue, devices). Client ID from developer.spotify.com/dashboard;
# add the redirect URI below to that app exactly as written. Then: .\jarvis.bat --spotify-login
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Keep Hugging Face downloads quiet
HF_HUB_DISABLE_SYMLINKS_WARNING=1
