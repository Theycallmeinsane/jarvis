{
  "manifest_version": 3,
  "name": "Jarvis Control",
  "version": "1.1.0",
  "description": "Lets your Jarvis voice assistant control Chrome: tabs, pages, links, videos, Instagram, Facebook and Claude. Talks only to Jarvis on this PC (127.0.0.1).",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "scripting", "alarms", "storage", "sessions"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Jarvis Control", "default_popup": "popup.html"}
}
